generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Article {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  titleEn     String
  titleTh     String
  summaryEn   String
  summaryTh   String
  bodyTh      String
  sourceUrl   String   @unique
  sourceName  String
  category    String   // gold, silver
  imageUrl    String?
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([publishedAt])
}

model Video {
  id          Int      @id @default(autoincrement())
  videoId     String   @unique // YouTube video ID
  title       String
  description String
  thumbnailUrl String
  channelTitle String
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([publishedAt])
}
